{
  "name": "Statis",
  "logo": {
    "dark": "/logo/statis-mark-dark.svg",
    "light": "/logo/statis-mark-light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#fb923c",
    "light": "#fdba74",
    "dark": "#ea7c1f",
    "background": {
      "dark": "#0a0a0a",
      "light": "#fafafa"
    }
  },
  "font": {
    "headings": { "family": "JetBrains Mono" },
    "body": { "family": "JetBrains Mono" }
  },
  "modeToggle": {
    "default": "dark"
  },
  "layout": "sidenav",
  "anchors": [],
  "rounded": "default",
  "topbarLinks": [
    { "name": "GitHub", "url": "https://github.com/statis-ai/statis-core" },
    { "name": "statis.dev", "url": "https://statis.dev" }
  ],
  "topbarCtaButton": {
    "name": "Console",
    "url": "https://console.statis.dev"
  },
  "tabs": [
    { "name": "Docs", "url": "docs" },
    { "name": "API Reference", "url": "api-reference" }
  ],
  "api": {
    "baseUrl": "https://api.statis.dev",
    "auth": {
      "method": "key",
      "name": "X-API-Key"
    }
  },
  "navigation": [
    {
      "group": "Get Started",
      "pages": [
        "docs/introduction",
        "docs/quickstart",
        "docs/concepts"
      ]
    },
    {
      "group": "@statis.gate",
      "pages": [
        "gate/reference",
        "gate/sync-vs-async",
        "gate/idempotency",
        "gate/error-handling",
        "gate/policy-graduation"
      ]
    },
    {
      "group": "Approval & Receipts",
      "pages": [
        "approvals/web-page",
        "approvals/slack",
        "receipts/schema",
        "receipts/verify"
      ]
    },
    {
      "group": "Policies & Adapters",
      "pages": [
        "policies/rules",
        "policies/shadow-mode",
        "policies/kill-switch",
        "adapters/overview"
      ]
    },
    {
      "group": "Frameworks",
      "pages": [
        "frameworks/langgraph",
        "frameworks/crewai",
        "frameworks/anthropic-sdk",
        "frameworks/openai-sdk",
        "frameworks/mcp"
      ]
    },
    {
      "group": "SDK Reference",
      "pages": [
        "sdks/python",
        "sdks/typescript",
        "sdks/cli"
      ]
    },
    {
      "group": "Self-Host",
      "pages": [
        "self-host/docker-compose",
        "self-host/quick-deploy"
      ]
    },
    {
      "group": "Enterprise",
      "pages": [
        "enterprise/overview",
        "enterprise/sso",
        "enterprise/scim",
        "enterprise/vpc-deploy",
        "enterprise/audit-export",
        "enterprise/threat-detection",
        "enterprise/pii-masking"
      ]
    },
    {
      "group": "statis-kit",
      "pages": [
        "statis-kit"
      ]
    },
    {
      "group": "API Reference",
      "pages": [
        "api-reference/introduction",
        "api-reference/endpoints/post-actions",
        "api-reference/endpoints/get-actions",
        "api-reference/endpoints/get-action",
        "api-reference/endpoints/post-evaluate",
        "api-reference/endpoints/post-approve",
        "api-reference/endpoints/post-reject",
        "api-reference/endpoints/get-escalations",
        "api-reference/endpoints/post-policy-rules",
        "api-reference/endpoints/get-policy-rules",
        "api-reference/endpoints/put-policy-rule",
        "api-reference/endpoints/delete-policy-rule",
        "api-reference/endpoints/get-receipt",
        "api-reference/endpoints/get-receipt-verify",
        "api-reference/endpoints/post-signup",
        "api-reference/endpoints/post-login",
        "api-reference/endpoints/get-me",
        "api-reference/endpoints/post-api-keys",
        "api-reference/endpoints/get-api-keys"
      ]
    }
  ],
  "redirects": [
    { "source": "/guides/introduction",  "destination": "/docs/introduction" },
    { "source": "/guides/quickstart",    "destination": "/docs/quickstart" },
    { "source": "/guides/architecture",  "destination": "/docs/concepts" },
    { "source": "/guides/primitives/action-contract",      "destination": "/gate/reference" },
    { "source": "/guides/primitives/policy-engine",        "destination": "/policies/rules" },
    { "source": "/guides/primitives/execution-guarantee",  "destination": "/gate/idempotency" },
    { "source": "/guides/primitives/receipt",              "destination": "/receipts/schema" },
    { "source": "/guides/shadow-mode",   "destination": "/policies/shadow-mode" },
    { "source": "/guides/escalation",    "destination": "/approvals/web-page" },
    { "source": "/guides/kill-switch",   "destination": "/policies/kill-switch" },
    { "source": "/guides/policy-rules",  "destination": "/policies/rules" },
    { "source": "/guides/adapters",      "destination": "/adapters/overview" },
    { "source": "/guides/console",       "destination": "/docs/introduction" },
    { "source": "/guides/security/sso-oidc",       "destination": "/enterprise/sso" },
    { "source": "/guides/security/siem-export",    "destination": "/enterprise/audit-export" },
    { "source": "/guides/security/threat-detection", "destination": "/enterprise/threat-detection" },
    { "source": "/guides/security/pii-masking",    "destination": "/enterprise/pii-masking" },
    { "source": "/guides/deployment/self-hosting", "destination": "/self-host/quick-deploy" },
    { "source": "/guides/deployment/docker-compose", "destination": "/self-host/docker-compose" },
    { "source": "/integrations/langchain",  "destination": "/frameworks/langgraph" },
    { "source": "/integrations/crewai",     "destination": "/frameworks/crewai" },
    { "source": "/integrations/mcp",        "destination": "/frameworks/mcp" },
    { "source": "/integrations/python-sdk", "destination": "/sdks/python" },
    { "source": "/integrations/node-sdk",   "destination": "/sdks/typescript" },
    { "source": "/overview/introduction",   "destination": "/docs/introduction" },
    { "source": "/overview/quickstart",     "destination": "/docs/quickstart" },
    { "source": "/overview/architecture",   "destination": "/docs/concepts" }
  ],
  "footerSocials": {
    "twitter": "https://x.com/statis_ai",
    "github": "https://github.com/statis-ai/statis-core"
  }
}
